{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@deepseek-ai/cordis": ["../../dsh-vision-bridge/node_modules/@deepseek-ai/cordis"],
      "@deepseek-ai/schemastery": ["../../dsh-vision-bridge/node_modules/@deepseek-ai/schemastery"]
    }
  },
  "include": ["src"]
}