{
  "name": "dsh-trae-solo",
  "version": "0.1.0",
  "description": "TRAE SOLO free model gateway for DeepSeek Harness: registers the trae-solo provider (auto-discovered vision + reasoning models) and bundles the traework2api multi-account gateway (login, check-in, credit monitoring, concurrency limits).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "trae",
    "trae-solo",
    "llm",
    "provider",
    "free",
    "gateway"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "server",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}